{
  "$schema": "node_modules/wrangler/config-schema.json",

  // 網站本身部署在 Vercel，這份設定已經不負責部署。
  //
  // 留著它只因為 D1 仍是內容的真相來源：`scripts/snapshot.mjs`、`scripts/warm_transforms.py`
  // 與 `pnpm db:migrate` 都靠 `wrangler d1 ... vconf-gallery` 找到這個資料庫，
  // 而 wrangler 是從這裡的 d1_databases 依名稱對應的。
  "name": "v-conf-gallery",
  "compatibility_date": "2026-09-17",

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vconf-gallery",
      "database_id": "df2fc9a1-fe5c-40ca-a9a6-f3b3ef5dfcca",
      "migrations_dir": "migrations"
    }
  ]
}
